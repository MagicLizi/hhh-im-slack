{
  "capabilities": {
    "conversations": {
      "findDirect": true,
      "list": true,
      "members": true,
      "search": true
    },
    "edit": true,
    "events": {
      "conversations": false,
      "deletions": false,
      "messages": false,
      "people": false,
      "reactions": false
    },
    "messages": {
      "get": true,
      "list": true
    },
    "people": {
      "batchMax": 2000,
      "bots": true,
      "get": true,
      "search": true
    },
    "perf": true,
    "reactions": {
      "add": true,
      "catalog": true,
      "list": true,
      "remove": true
    },
    "readSync": {
      "conversations": true,
      "watermark": true
    },
    "recall": true,
    "resources": {
      "avatars": true,
      "read": true,
      "variants": true
    },
    "retranslate": false,
    "richSend": {
      "edit": true,
      "formats": [
        "strong",
        "emphasis",
        "delete",
        "inlineCode",
        "link",
        "blockquote",
        "list",
        "code"
      ]
    },
    "send": {
      "file": true,
      "image": true,
      "lookup": false,
      "mentionAll": true,
      "mentions": true,
      "text": true
    },
    "session": {
      "renew": true
    }
  },
  "loginMethods": [
    {
      "defaultValue": "https://hhh-im-auth.magiclizi.com",
      "id": "relay",
      "kind": "relay",
      "label": "通过中继登录",
      "note": "经授权中继领回 Slack 的授权，令牌在本机换取、中继不保存。默认是 HHH 的中继；换成自己部署的中继时，要在它上面配好自己的 Slack 应用。",
      "placeholder": "输入中继地址，https://…"
    }
  ],
  "platform": {
    "actions": {
      "edit": {
        "own": true,
        "perMessage": true
      },
      "react": true,
      "recall": {
        "own": true
      },
      "reply": false,
      "thread": true
    },
    "avatarIdentity": {
      "keyPattern": "^(?i:https)://(?:[^/?#]*\\.(?i:slack-edge\\.com)(?::[0-9]*)?/|(?i:secure\\.gravatar\\.com)(?::[0-9]*)?/(?:[^/?#]*/)*)([^?#]*?)(?:[_-][0-9]+)?(?:\\.[^./?#]*)?(?:[?#]|$)",
      "variantPattern": "^(?i:https)://(?:[^/?#]*\\.(?i:slack-edge\\.com)(?::[0-9]*)?/[^?#]*?[_-]|(?i:secure\\.gravatar\\.com)(?::[0-9]*)?/[^#]*?[?&]s=)([0-9]+)(?:\\.[^./?#]*)?(?:[?#&]|$)"
    },
    "avatarShape": "rounded",
    "chatLink": "https://slack.com/app_redirect?channel={conversation}",
    "conversationNouns": {
      "channel": "频道",
      "direct": "会话",
      "group": "会话",
      "unknown": "会话"
    },
    "deletedMessagesVanish": true,
    "discovery": {
      "coldPages": 15,
      "fastestSecs": 30,
      "pages": 5
    },
    "downloads": {
      "perMinute": 80,
      "perSecond": 5
    },
    "emoji": {
      "namePattern": "^(?:[^\\s:!\"#$%&()*,./;<=>?@\\[\\\\\\]^`{|}~]|[^\\s:!\"#$%&()*,./;<=>?@\\[\\\\\\]^`{|}~][^\\s!\"#$%&()*,./;<=>?@\\[\\\\\\]^`{|}~]*[^\\s:!\"#$%&()*,./;<=>?@\\[\\\\\\]^`{|}~])$",
      "textPattern": ":([^:\\s]+(?:::skin-tone-[2-6])?):",
      "textTemplate": ":{type}:",
      "unlisted": {
        "placeholderLabel": ""
      }
    },
    "emojiPerAccount": true,
    "history": "server",
    "imageNamePrefix": "Slack 图片",
    "limits": {
      "attachmentNameMaxBytes": 255,
      "fileUploadMaxBytes": 31457280,
      "imageUploadMaxBytes": 31457280
    },
    "pageMax": 200,
    "reactionsInReads": true,
    "readDefaults": {
      "active": 5,
      "discover": 60,
      "dormant": 300,
      "people": 600,
      "profile": 600,
      "quiet": 60,
      "stale": 600,
      "threadDays": 7,
      "watching": 2
    },
    "reads": {
      "perMinute": 40,
      "perSecond": 1
    },
    "threads": {
      "activityOnRoot": true,
      "broadcast": {
        "attachments": false,
        "native": true
      },
      "readsAfter": true
    },
    "userAdjustable": [
      "readIntervals"
    ]
  },
  "protocolVersion": 1,
  "provider": {
    "id": "slack",
    "name": "Slack",
    "version": "1.0.9"
  },
  "readRequestGating": true,
  "settings": []
}
